# Dramallyu — configuration OPERATEUR.
#
# Regle du projet : AUCUNE cle d'acces a un service tiers ici. Les cles debrid,
# trackers et TMDB sont fournies par CHAQUE UTILISATEUR dans sa propre config
# (page /configure). Ce fichier ne contient que de l'infrastructure.

PORT=7020

# URL publique de l'addon (sert a construire les liens absolus : /resolve, /sub...).
# Laisser vide derriere un reverse-proxy correct : les en-tetes X-Forwarded-* suffisent.
PUBLIC_URL=

# Secret de signature des jetons /resolve et /sub (HMAC). OBLIGATOIRE en production.
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Mot de passe de la page /admin. Vide = page admin desactivee.
ADMIN_PASSWORD=

# MediaFlow (mfp-light) — utilise pour router les liens AllDebrid (compte partage :
# evite le bannissement multi-IP) et proxifier le HLS quand c'est necessaire.
MEDIAFLOW_URL=
MEDIAFLOW_PASSWORD=
